-- 03_ballot_open.cov
--
-- AUDIT FIXTURE — Open public ballot with deadline + first-time-caller guard.
--
-- Purpose : exercise the `ballot` synthesis path AND the `when` /
-- `only` / `given` guard composition that auditors most often ask
-- about ("can a malicious caller bypass the deadline ?").
--
-- Synthesized surface (auditors should verify) :
--   Fields :   tally: map<choice, amount>, opened_at: timestamp, options
--   Actions :  cast(pick: choice)        — guarded by when/only/given
--   Reveals :  winner returns choice     — only after deadline
--   Events :   Cast(caller, pick)
--
-- Guard semantics (CRITICAL audit point) :
--   `when now < opened_at + duration` — deadline check ; reverts if past.
--   `only first_time_caller`           — replay protection ; reverts if
--                                        caller already voted.
--   `given pick in options`            — input validation ; reverts if
--                                        pick is not one of the 3 options.
--   All three are evaluated BEFORE the body executes. Failure = revert,
--   no state change, no event.
--
-- Negative-test scenarios (auditors should construct) :
--   - Vote past the deadline → expect revert.
--   - Same caller votes twice → second tx reverts.
--   - Vote with `pick = "maybe"` (not in options) → expect revert.
--   - Reveal before deadline → expect revert.
--
-- EXPECTED LINT FINDINGS (this fixture intentionally trips them) :
--   * C200 — timestamp drift via `now`. The linter flags every use of
--     `now` because miners can shift block.timestamp by ~15 seconds.
--     For a 7-day ballot this drift is irrelevant ; suppress with
--     `@allow(C200)` if the ballot logic tolerates it. Fixture left
--     unsuppressed to demonstrate the linter is wired and active.

ballot AuditBallot {
    options: [choice] = ["yes", "no", "abstain"]
    duration: duration  = 7 days

    action cast(pick: choice)
            when now < opened_at + duration,
            only first_time_caller,
            given pick in options {
        tally[pick] += 1
        emit Cast(caller, pick)
    }

    reveal winner returns choice
            when now >= opened_at + duration {
        tally.argmax
    }
}
