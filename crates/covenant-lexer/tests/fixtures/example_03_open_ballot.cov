-- OpenBallot.cov · a public ballot with a deadline.
-- Every vote is visible on-chain the moment it is cast. This is the
-- transparency baseline. Example 4 (encrypted counter) shows how to
-- hide intermediate tallies while keeping the final result verifiable.
--
-- NOTE (compiler status): two conveniences are intentionally NOT used here
-- because they have no lowering yet and the compiler now refuses them rather
-- than miscompile them silently:
--   * `given pick in options`  → E426 (the `in` operator is a ListContains
--     loop; it used to compile to `pick == options[0]` only, silently rejecting
--     every option but the first). Omitted until `in` is lowered.
--   * `tally.argmax`           → E427 (map .argmax has no key array to iterate;
--     it used to compile to StructGet(0) and return a constant). The reveal
--     returns a placeholder until an enumerable-map reduction exists.

ballot OpenBallot {
    options: [choice] = ["yes", "no", "abstain"]
    duration: duration  = 7 days

    action cast(pick: choice)
            when now < opened_at + duration,
            only first_time_caller {
        tally[pick] += 1
        emit Cast(caller, pick)
    }

    -- The real reveal is `winner` = the choice with the max tally, which needs
    -- map .argmax (refused by E427 until an enumerable-map reduction exists).
    -- Until then, expose a computable deadline-gated fact: when voting closed.
    reveal deadline returns time
            when now >= opened_at + duration {
        opened_at + duration
    }
}
